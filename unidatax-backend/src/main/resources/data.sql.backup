-- 创建索引
CREATE INDEX IF NOT EXISTS idx_username ON t_user(username);
CREATE INDEX IF NOT EXISTS idx_email ON t_user(email);
CREATE INDEX IF NOT EXISTS idx_status ON t_user(status);
CREATE INDEX IF NOT EXISTS idx_user_create_time ON t_user(create_time);

CREATE INDEX IF NOT EXISTS idx_task_user_id ON t_query_task(user_id);
CREATE INDEX IF NOT EXISTS idx_task_name ON t_query_task(task_name);
CREATE INDEX IF NOT EXISTS idx_task_status ON t_query_task(status);
CREATE INDEX IF NOT EXISTS idx_task_create_time ON t_query_task(create_time);