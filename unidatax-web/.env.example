# API配置示例文件
# 复制此文件为 .env 并修改相应配置

# ========== 生产环境配置 ==========
# 后端API基础URL (生产环境使用)
REACT_APP_API_BASE_URL=/api

# 应用信息
REACT_APP_APP_NAME=Trino Frontend
REACT_APP_VERSION=1.0.0

# ========== 开发环境代理配置 ==========
# 开发环境后端服务地址 (setupProxy.js使用)
REACT_APP_BACKEND_URL=http://localhost:8080

# 外部API服务地址
REACT_APP_GRAVITINO_URL=http://10.177.64.21:16001
REACT_APP_TRINO_URL=https://trino-http.test.unicom.local:16000

# ========== 不同部署场景示例 ==========
# 单机部署 (推荐):
# REACT_APP_API_BASE_URL=/api

# 分离部署:
# REACT_APP_API_BASE_URL=http://backend-server:8080/api

# 域名部署:
# REACT_APP_API_BASE_URL=https://api.your-domain.com/api